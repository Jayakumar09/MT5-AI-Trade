# ── QUANT PILOT configuration ──────────────────────────────────────────────────
# Copy to .env. Demo Mode is ON by default: no broker, no API key required.

# DEMO | PAPER   (MT5_DEMO / MT5_LIVE are selected automatically when MT5 connects)
MODE=DEMO
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Anthropic (optional) ──────────────────────────────────────────────────────
# Without a key the Analyst uses a rule-based mock (deterministic, offline).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── MetaTrader5 (optional, Windows only) ─────────────────────────────────────
# Leave ENABLE_MT5=false to stay in Demo/Paper. The terminal must be running
# and logged in for the bridge to work.
ENABLE_MT5=false
MT5_MODE=demo_only            # demo_only | live  (live also requires typed confirmation in Settings)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
MT5_MAGIC=16112026

# ── Strategy parameters (sensible defaults; edit in Settings) ──────────────────
RISK_PER_TRADE=1.0
MAX_RISK_PER_TRADE=2.0
MAX_DAILY_DRAWDOWN=4.0
MAX_OPEN_TRADES=5
MIN_RR=2.0
MIN_CONFIDENCE=7
SPREAD_LIMIT_XAU=35
SPREAD_LIMIT_BTC=500
